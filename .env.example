# LinkedIn Credentials
# REQUIRED: Your LinkedIn login credentials
LINKEDIN_USERNAME=your_email@example.com
LINKEDIN_PASSWORD=your_password_here

# OpenAI API Key
# OPTIONAL: For AI-powered question answering
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# AI Provider
# - ollama: local models via Ollama (recommended for resume-aware form filling)
# - openai: cloud models via OpenAI API
AI_PROVIDER=ollama

# Ollama settings (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional: pin a model name (e.g. llama3.1:8b-instruct). Leave empty for auto-selection.
OLLAMA_MODEL=

# Q&A memory matching (optional; overrides config.yaml qa_memory when set)
# QA_MEMORY_FUZZY_HIGH=88
# QA_MEMORY_FUZZY_LOW=62
# QA_MEMORY_INTENT_LLM=true
# QA_MEMORY_INTENT_TOP_K=25
# QA_MEMORY_EMBEDDING=false
# QA_MEMORY_EMBEDDING_MODEL=nomic-embed-text
# QA_MEMORY_EMBEDDING_THRESHOLD=0.82
# QA_MEMORY_CHAT_MODEL=   # optional: model for intent JSON picker (defaults to OLLAMA_MODEL / auto)

# Instructions:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual credentials
# 3. NEVER commit the .env file to version control
